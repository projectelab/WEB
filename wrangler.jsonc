{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webl",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "www.desorden.cat/*",
      "zone_name": "desorden.cat"
    },
    {
      "pattern": "desorden.cat/*",
      "zone_name": "desorden.cat"
    }
  ],
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTACT_LEADS",
        "class_name": "ContactLeadStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ContactLeadStore"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "20260924",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "send_email": [
    {
      "name": "LEAD_EMAIL"
    }
  ]
}
