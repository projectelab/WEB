{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WEB Bridge Job",
  "type": "object",
  "properties": {
    "schema_version": { "type": "string", "const": "1" },
    "repo": { "type": "string", "const": "projectelab/WEB" },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "objective": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "validation_level": {
      "type": "string",
      "enum": ["L1", "L2", "L3", "L4", "L5"]
    },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbidden": {
      "type": "array",
      "items": { "type": "string" }
    },
    "pr_title": { "type": "string", "minLength": 1 }
  },
  "required": [
    "schema_version",
    "repo",
    "base_sha",
    "objective",
    "model",
    "validation_level",
    "allowed_paths",
    "forbidden",
    "pr_title"
  ],
  "additionalProperties": false
}
