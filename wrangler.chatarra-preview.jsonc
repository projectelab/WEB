{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chatarra-preview",
  "compatibility_date": "2026-09-24",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./chatarra-preview-dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
